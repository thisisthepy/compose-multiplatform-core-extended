@@ -2,6 +2,20 @@ package org.jetbrains.skiko
 
 expect fun setSystemLookAndFeel()
 
+/**
+ * Whether this process may use the Java toolkit at all, read from `compose.awt`.
+ *
+ * `false` is for an embedder that opens its own windows and builds a GraalVM native image with
+ * `-Dcompose.awt=false`, initialising this class while the image is built. The analysis walks
+ * every branch, so a run-time check cannot keep the toolkit out of the image, and a constant
+ * can: the branch below that sets a look and feel is dead, and `UIManager` with it. Anywhere
+ * else the property is unset and behaviour does not change.
+ */
+internal object AwtSwitch {
+    @JvmField
+    val available: Boolean = System.getProperty("compose.awt") != "false"
+}

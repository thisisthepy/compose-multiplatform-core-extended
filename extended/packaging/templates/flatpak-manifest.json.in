{
  "id": "{{identifier}}",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "{{runtime_version}}",
  "sdk": "org.freedesktop.Sdk",
  "command": "{{executable}}",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "{{executable}}",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/lib/{{executable}} /app/bin",
        "install -m755 payload/{{executable}} /app/lib/{{executable}}/{{executable}}",
        "ln -s ../lib/{{executable}}/{{executable}} /app/bin/{{executable}}",
        "install -Dm644 packaging/{{identifier}}.desktop /app/share/applications/{{identifier}}.desktop",
        "install -Dm644 packaging/{{identifier}}.metainfo.xml /app/share/metainfo/{{identifier}}.metainfo.xml",
        "install -Dm644 packaging/{{identifier}}.png /app/share/icons/hicolor/256x256/apps/{{identifier}}.png"
      ],
      "sources": [
        { "type": "dir", "path": "payload", "dest": "payload" },
        { "type": "dir", "path": "packaging", "dest": "packaging" }
      ]
    }
  ]
}
